{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:monthly"
  ],
  "packageRules": [
    {
      "minimumReleaseAge": "3 days",
      "matchPackageNames": ["*"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:monthly"]
  },
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
